<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <description>Build Manager: active-skin presentation; scrollbar interaction stays in XML.</description>
    <coordinates>
        <system>1</system>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <include>Animation_DialogPopupOpenClose</include>
    <controls>
        <control type="group">
            <top>105</top>
            <centerleft>50%</centerleft>
            <width>1520</width>
            <height>870</height>
            <include>Animation_DialogPopupVisible</include>
            <include content="DialogBackgroundCommons">
                <param name="width">1520</param>
                <param name="height">870</param>
                <param name="header_label" />
                <param name="header_id">10</param>
            </include>
            <control type="image">
                <left>10</left>
                <top>80</top>
                <width>1200</width>
                <height>790</height>
                <texture border="40">buttons/dialogbutton-nofo.png</texture>
            </control>
            <control type="list" id="100">
                <left>29</left>
                <top>100</top>
                <width>1160</width>
                <height>750</height>
                <orientation>vertical</orientation>
                <pagecontrol>120</pagecontrol>
                <onleft>201</onleft>
                <onright>201</onright>
                <onup>100</onup>
                <ondown>100</ondown>
                <scrolltime>200</scrolltime>
                <itemlayout width="1160" height="70">
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <right>52%</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <selectedcolor>white</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>false</scroll>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <right>180</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <selectedcolor>white</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>false</scroll>
                    </control>
                    <control type="label">
                        <left>52%</left>
                        <top>0</top>
                        <right>40</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <selectedcolor>white</selectedcolor>
                        <align>right</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label2]</label>
                        <visible>!String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>false</scroll>
                    </control>
                    <control type="image">
                        <right>20</right>
                        <centertop>50%</centertop>
                        <width>120</width>
                        <height>76</height>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true) + ListItem.IsSelected</visible>
                        <texture>buttons/radio-button-on.png</texture>
                    </control>
                    <control type="image">
                        <right>20</right>
                        <centertop>50%</centertop>
                        <width>120</width>
                        <height>76</height>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true) + !ListItem.IsSelected</visible>
                        <texture>buttons/radio-button-off.png</texture>
                    </control>
                </itemlayout>
                <focusedlayout width="1160" height="70">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>1160</width>
                        <height>70</height>
                        <texture colordiffuse="button_focus">lists/focus.png</texture>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <right>52%</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <selectedcolor>white</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>true</scroll>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <right>180</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <selectedcolor>white</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>true</scroll>
                    </control>
                    <control type="label">
                        <left>52%</left>
                        <top>0</top>
                        <right>40</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>white</textcolor>
                        <selectedcolor>white</selectedcolor>
                        <align>right</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label2]</label>
                        <visible>!String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>true</scroll>
                    </control>
                    <control type="image">
                        <right>20</right>
                        <centertop>50%</centertop>
                        <width>120</width>
                        <height>76</height>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true) + ListItem.IsSelected</visible>
                        <texture>buttons/radio-button-on.png</texture>
                    </control>
                    <control type="image">
                        <right>20</right>
                        <centertop>50%</centertop>
                        <width>120</width>
                        <height>76</height>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true) + !ListItem.IsSelected</visible>
                        <texture>buttons/radio-button-off.png</texture>
                    </control>
                </focusedlayout>
            </control>
            <control type="textbox" id="110">
                <left>29</left>
                <top>100</top>
                <width>1160</width>
                <height>750</height>
                <font>font13</font>
                <textcolor>white</textcolor>
                <pagecontrol>121</pagecontrol>
                <autoscroll>false</autoscroll>
            </control>
            <control type="scrollbar" id="120">
                <left>1189</left>
                <top>100</top>
                <width>12</width>
                <height>750</height>
                <orientation>vertical</orientation>
                <visible>Control.IsVisible(100)</visible>
                <onleft>100</onleft>
                <onright>201</onright>
                <showonepage>true</showonepage>
            </control>
            <control type="scrollbar" id="121">
                <left>1189</left>
                <top>100</top>
                <width>12</width>
                <height>750</height>
                <orientation>vertical</orientation>
                <visible>Control.IsVisible(110)</visible>
                <onleft>201</onleft>
                <onright>201</onright>
                <showonepage>true</showonepage>
            </control>
            <control type="grouplist" id="9000">
                <left>1210</left>
                <top>92</top>
                <width>300</width>
                <height>750</height>
                <orientation>vertical</orientation>
                <itemgap>-10</itemgap>
                <onleft condition="Control.IsVisible(110)">121</onleft>
                <onleft condition="!Control.IsVisible(110)">100</onleft>
                <onright condition="Control.IsVisible(110)">121</onright>
                <onright condition="!Control.IsVisible(110)">100</onright>
                <include content="DefaultDialogButton">
                    <param name="id">201</param>
                    <param name="label" />
                </include>
                <include content="DefaultDialogButton">
                    <param name="id">202</param>
                    <param name="label" />
                </include>
                <include content="DefaultDialogButton">
                    <param name="id">203</param>
                    <param name="label" />
                </include>
                <include content="DefaultDialogButton">
                    <param name="id">204</param>
                    <param name="label" />
                </include>
            </control>
        </control>
    </controls>
</window>
