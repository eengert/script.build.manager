<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <description>Build Manager: active-skin presentation; scrollbar interaction stays in XML.</description>
    <coordinates>
        <system>1</system>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture colordiffuse="99000000">bm-white.png</texture>
        </control>
        <control type="group">
            <centerleft>50%</centerleft>
            <top>100</top>
            <width>1560</width>
            <height>880</height>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1560</width>
                <height>880</height>
                <texture colordiffuse="FF20252B" border="16">bm-panel.png</texture>
            </control>
            <control type="label" id="10">
                <left>40</left>
                <top>30</top>
                <width>1460</width>
                <height>60</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <label />
            </control>
