                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>false</scroll>
                    </control>
                    <control type="label">
                        <left>52%</left>
                        <top>0</top>
                        <right>40</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
                        <align>right</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label2]</label>
                        <visible>!String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>false</scroll>
                    </control>
                    <control type="image">
                        <right>45</right>
                        <centertop>50%</centertop>
                        <width>36</width>
                        <height>36</height>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true) + ListItem.IsSelected</visible>
                        <texture>bm-check-on.png</texture>
                    </control>
                    <control type="image">
                        <right>45</right>
                        <centertop>50%</centertop>
                        <width>36</width>
                        <height>36</height>
                        <visible>String.IsEqual(ListItem.Property(bm.toggle),true) + !ListItem.IsSelected</visible>
                        <texture>bm-check-off.png</texture>
                    </control>
                </itemlayout>
                <focusedlayout width="1100" height="70">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>1100</width>
                        <height>70</height>
