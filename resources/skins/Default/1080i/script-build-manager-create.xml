                <left>40</left>
                <top>130</top>
                <width>1100</width>
                <height>660</height>
                <orientation>vertical</orientation>
                <pagecontrol>120</pagecontrol>
                <onleft>201</onleft>
                <onright>201</onright>
                <onup>100</onup>
                <ondown>100</ondown>
                <scrolltime>200</scrolltime>
                <itemlayout width="1100" height="70">
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <right>52%</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
                        <align>left</align>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEqual(ListItem.Property(bm.toggle),true)</visible>
                        <scroll>false</scroll>
                    </control>
                    <control type="label">
                        <left>40</left>
                        <top>0</top>
                        <right>180</right>
                        <height>70</height>
                        <font>font13</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <selectedcolor>FFFFFFFF</selectedcolor>
