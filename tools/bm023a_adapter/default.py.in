"""Temporary in-process trigger for the authorized BM-023A macOS validation."""
import sys

_PLATFORM_REQUESTED = bool(sys.argv[1:]) and (
    sys.argv[1].startswith("platform_check") or
    sys.argv[1].startswith("?mode=platform_check"))
_PREVIOUS_BYTECODE_FLAG = sys.dont_write_bytecode
_PREVIOUS_SYS_PATH = list(sys.path)
_PREVIOUS_META_PATH = list(sys.meta_path)


def _platform_module(name):
    return name in ("adapter_support", "adapter_config", "resources") or name.startswith("resources.")


_PREVIOUS_PLATFORM_MODULES = {name: module for name, module in sys.modules.copy().items()
    if _platform_module(name)}

try:
    if _PLATFORM_REQUESTED:
        # Invalid diagnostic requests never import adapter code or write a result.
        if sys.argv[1:] not in (["platform_check"], ["?mode=platform_check"]):
            raise SystemExit("platform_check arguments refused")
        if _PREVIOUS_PLATFORM_MODULES:
            raise ImportError("platform_check preloaded module refused")
        sys.dont_write_bytecode = True
        # Use only the interpreter's already-loaded os before isolating imports.
        # Importing os (or another helper) through the driver path here would
        # merely move the unscoped-import vulnerability earlier in startup.
        _platform_os = sys.modules.get("os")
        if _platform_os is None:
            raise ImportError("platform_check import isolation unavailable")
        _platform_driver = _platform_os.path.dirname(_platform_os.path.abspath(__file__))
        _platform_driver_stat = _platform_os.stat(_platform_driver)
        _platform_driver_identity = (_platform_driver_stat.st_dev, _platform_driver_stat.st_ino)
        _platform_isolated_roots = {_platform_driver_identity}
        # The staged product is the driver's fixed sibling. Exclude it before
        # even stdlib imports; recheck the VFS-located product below as well.
        try:
            _platform_product_stat = _platform_os.stat(_platform_os.path.join(
                _platform_os.path.dirname(_platform_driver), "script.build.manager"), follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            if _platform_product_stat.st_mode & 0o170000 != 0o040000:
                raise ImportError("platform_check product isolation unavailable")
            _platform_isolated_roots.add((_platform_product_stat.st_dev, _platform_product_stat.st_ino))

        def _platform_import_path_allowed(raw):
            """Remove staged source aliases/descendants before unscoped imports.

            Resolve one component at a time so a forbidden symlink destination
            is rejected before probing it. Unverifiable search entries are
            omitted for this diagnostic only; the outer finally restores them.
            """
            try:
                raw = raw or "."
                if not raw.startswith("/"):
                    raw = _platform_os.getcwd() + "/" + raw
                # Do not collapse '..' before resolving preceding symlinks.
                pending = raw.split("/")
                resolved = []
                links = 0
                while pending:
                    part = pending.pop(0)
                    if part in ("", "."):
                        continue
                    if part == "..":
                        resolved = resolved[:-1]
                        continue
                    candidate = "/" + "/".join(resolved + [part])
                    lexical = candidate.lower()
                    if lexical.startswith("/system/volumes/data/"):
                        lexical = lexical[len("/system/volumes/data"):]
                    if (lexical == "/applications/kodi.app" or
                        lexical.startswith("/applications/kodi.app/") or
                        lexical.startswith("/users/eengert/library/application support/kodi") or
                        part.lower() in (".vol", ".nofollow", ".resolve")):
                        return False
                    info = _platform_os.lstat(candidate)
                    if info.st_mode & 0o170000 == 0o120000:
                        links += 1
                        if links > 40:
                            return False
                        destination = _platform_os.readlink(candidate)
                        if destination.startswith("/"):
                            resolved = []
                        pending = destination.split("/") + pending
                        continue
                    if (info.st_dev, info.st_ino) in _platform_isolated_roots:
                        return False
                    resolved.append(part)
                return True
            except (OSError, TypeError, ValueError, AttributeError):
                return False

        sys.path[:] = [entry for entry in sys.path if _platform_import_path_allowed(entry)]
        import hashlib as _platform_hashlib
        import importlib.machinery as _platform_machinery
        import importlib.util as _platform_util
        import json as _platform_json
        import os as _platform_os

        class _PlatformSourceLoader(_platform_machinery.SourceFileLoader):
            """Compile only the named source bytes; never consult/write bytecode."""
            def __init__(self, name, path, expected):
                super().__init__(name, path)
                self.expected = expected

            def get_code(self, fullname):
                data = self.get_data(self.path)
                if self.expected is not None and _platform_hashlib.sha256(data).hexdigest() != self.expected:
                    raise ImportError("platform_check source identity refused")
                return self.source_to_code(data, self.path)

        class _PlatformSourceFinder:
            product_root = None
            driver_root = _platform_os.path.dirname(_platform_os.path.abspath(__file__))

            def find_spec(self, fullname, path=None, target=None):
                if not _platform_module(fullname):
                    return None
                if fullname == "adapter_config":
                    filename = _platform_os.path.join(self.driver_root, "adapter_config.py")
                    expected = None  # Exact config source is bound by the host stage manifest.
                    package = False
                else:
                    config = sys.modules.get("adapter_config")
                    if config is None:
                        raise ImportError("platform_check source binding unavailable")
                    binding = _platform_json.loads(config.PLATFORM_SOURCE_BINDING)
                    if fullname == "adapter_support":
                        filename = _platform_os.path.join(self.driver_root, "adapter_support.py")
                        expected = binding["adapter"]["adapter_support.py"]
                        package = False
                    else:
                        if self.product_root is None:
                            raise ImportError("platform_check product root unavailable")
                        relative = fullname.replace(".", "/")
                        if fullname == "resources" and relative + "/__init__.py" not in binding["product"]:
                            spec = _platform_machinery.ModuleSpec(fullname, None, is_package=True)
                            spec.submodule_search_locations = [_platform_os.path.join(self.product_root, relative)]
                            return spec
                        package = relative + "/__init__.py" in binding["product"]
                        relative += "/__init__.py" if package else ".py"
                        expected = binding["product"].get(relative)
                        if expected is None:
                            raise ImportError("platform_check unbound module refused")
                        filename = _platform_os.path.join(self.product_root, relative)
                loader = _PlatformSourceLoader(fullname, filename, expected)
                return _platform_util.spec_from_file_location(fullname, filename, loader=loader,
                    submodule_search_locations=[_platform_os.path.dirname(filename)] if package else None)

        _PLATFORM_FINDER = _PlatformSourceFinder()
        sys.meta_path.insert(0, _PLATFORM_FINDER)

    import importlib
    import json
    import os
    import sys
    import tempfile
    from pathlib import Path

    import xbmc
    import xbmcvfs

    from adapter_config import (
        ARTIFACT_ROOT,
        CONFIGURATION_PATH,
        DEVICE_PROFILE_ID,
        EXPECTED_FROZEN_INSTALL_SHA256,
        EXPECTED_OVERLAY_ID,
        MANIFEST_PATH,
        OVERLAY_SOURCE,
    )
    from adapter_support import (
        DRIVER_ADDON_ID,
        AdapterBootstrapError,
        choose_missing_artifact_resolution,
        identify_adapter_result,
        inspect_retained_inputs,
        parse_adapter_mode,
        recover_frozen_install,
        recover_library_frozen_install,
        retry_held_frozen_install,
        safe_failure_payload,
        read_adapter_status,
        read_native_recovery_identity,
        read_platform_check,
        _platform_directory,
        _platform_read,
        write_platform_result,
        reject_cached_production_modules,
        repair_frozen_install_source,
        require_retained_inputs,
        stage_manifest_artifacts,
        verify_build_manager_source,
        verify_frozen_install_source,
        verify_production_module_sources,
    )


    RESULT_PATH = None
    FROZEN_INSTALL_SOURCE_RECORD = None
    RETAINED_INPUTS_RECORD = None
    STAGE = "LOCATE_BUILD_MANAGER"
    FAILING_CALLABLE = "xbmcvfs.translatePath"


    def _rpc(method, params):
        response = json.loads(xbmc.executeJSONRPC(json.dumps({
            "jsonrpc": "2.0", "method": method, "params": params, "id": 1,
        })))
        if "error" in response:
            raise RuntimeError("jsonrpc_error")
        return response.get("result", {})


    def _safe_transaction(transaction):
        if transaction is None:
            return None
        return {
            "phase": getattr(transaction.phase, "value", transaction.phase),
            "lifecycle_stage": getattr(transaction.lifecycle_stage, "value", transaction.lifecycle_stage),
            "lifecycle_restart_count": transaction.lifecycle_restart_count,
            "activation_hold_ids": list(transaction.activation_hold_ids),
            "activation_hold_released": transaction.activation_hold_released,
            "private_overlay_required": transaction.private_overlay_required,
            "original_update_policy": transaction.original_update_policy,
            "updater_guard_required": transaction.updater_guard_required,
            "status_code": transaction.status_code,
            "resolution_records": [
                {
                    "addon_id": record.addon_id,
                    "resolution": getattr(record.resolution, "value", record.resolution),
                    "state": getattr(record.state, "value", record.state),
                    "resolved_version": record.resolved_version,
                    "desired_enabled": record.desired_enabled,
                    "repository_id": record.repository_id,
                }
                for record in transaction.resolution_records
            ],
        }


    def _write_result(payload):
        RESULT_PATH.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(
            prefix=".bm023a-result.", suffix=".tmp", dir=str(RESULT_PATH.parent)
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(payload, handle, sort_keys=True)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary, RESULT_PATH)
        finally:
            try:
                os.unlink(temporary)
            except OSError:
                pass


    def main():
        global STAGE, FAILING_CALLABLE, RESULT_PATH, FROZEN_INSTALL_SOURCE_RECORD
        global RETAINED_INPUTS_RECORD
        payload = {"ok": False, "error_type": "not_started"}
        # Early location failures must also use the directory-preserving writer.
        mode = "platform_check" if _PLATFORM_REQUESTED else "unselected"
        try:
            STAGE = "LOCATE_BUILD_MANAGER"
            FAILING_CALLABLE = "xbmcvfs.translatePath"
            def locate(path):
                translated = Path(xbmcvfs.translatePath(path))
                if _PLATFORM_REQUESTED:
                    fd = _platform_directory(translated)
                    os.close(fd)
                    return translated
                return translated.resolve(strict=True)
            profile_root = locate("special://profile/")
            RESULT_PATH = profile_root / "addon_data" / "script.build.manager" / "bm023a_live_result.json"
            addons_root = locate("special://home/addons")
            addon_root = locate("special://home/addons/script.build.manager")
            if (
                profile_root.name != "userdata"
                or profile_root.parent.name != "portable_data"
                or "Kodi Build Manager Test.app/Contents/Resources/Kodi/portable_data" not in str(profile_root)
            ):
                raise AdapterBootstrapError(
                    "LOCATE_BUILD_MANAGER", "xbmcvfs.translatePath", "addon_root_mismatch"
                )
            if not addon_root.is_dir():
                raise AdapterBootstrapError(
                    "LOCATE_BUILD_MANAGER", "pathlib.Path", "addon_root_mismatch"
                )
            # Kodi's script argv is [script_path, first_addon_argument, ...].
            # The mode must be taken from argv[1], not argv[2].
            mode = parse_adapter_mode(sys.argv[1:])

            if mode != "platform_check":
                sys.path.insert(0, str(addon_root))
            if mode == "platform_check":
                _PLATFORM_FINDER.product_root = str(addon_root)
                _platform_product_stat = os.stat(addon_root, follow_symlinks=False)
                _platform_isolated_roots.add((_platform_product_stat.st_dev, _platform_product_stat.st_ino))
                sys.path[:] = list(filter(_platform_import_path_allowed, sys.path))
                production_module_names = ["resources.lib.frozen_install", "resources.lib.frozen", "resources.lib.artifacts"]
            elif mode == "status":
                production_module_names = [
                    "resources.lib.frozen_install",
                    "resources.lib.transaction",
                    "resources.lib.build_library",
                ]
            else:
                production_module_names = [
                    "resources.lib.artifacts",
                    "resources.lib.frozen_install",
                    "resources.lib.restart_coordinator",
                    "resources.lib.update_guard",
                ]
            if mode in ("recover", "retry"):
                production_module_names.append("resources.lib.frozen")
            if mode == "recover":
                production_module_names.append("resources.lib.build_library")
            if mode == "retry":
                production_module_names.append("resources.lib.build_manager")
            elif mode == "install":
                production_module_names.extend((
                    "resources.lib.build_manager",
                    "resources.lib.frozen",
                    "resources.lib.private_overlay",
                ))

            STAGE = "IMPORT_PRODUCTION_MODULES"
            FAILING_CALLABLE = "importlib.import_module"
            reject_cached_production_modules(production_module_names)

            STAGE = "IMPORT_RESOURCES"
            FAILING_CALLABLE = "importlib.import_module"
            resources_lib = importlib.import_module("resources.lib")

            STAGE = "VERIFY_BUILD_MANAGER_SOURCE"
            FAILING_CALLABLE = "pathlib.Path"
            verify_build_manager_source(addons_root, addon_root, resources_lib)
            if mode not in ("status", "platform_check"):
                FROZEN_INSTALL_SOURCE_RECORD = repair_frozen_install_source(
                    addon_root,
                    EXPECTED_FROZEN_INSTALL_SHA256,
                    profile_root / "addon_data" / DRIVER_ADDON_ID / "frozen_install_backups",
                )
            verify_frozen_install_source(
                addon_root, EXPECTED_FROZEN_INSTALL_SHA256
            )

            STAGE = "IMPORT_PRODUCTION_MODULES"
            FAILING_CALLABLE = "importlib.import_module"
            if mode == "platform_check":
                STAGE = "PLATFORM_CHECK"
                FAILING_CALLABLE = "read_platform_check"
                import adapter_config
                payload = read_platform_check(addon_root, Path(__file__).parent,
                    getattr(adapter_config, "PLATFORM_SOURCE_BINDING", None), MANIFEST_PATH, ARTIFACT_ROOT)
            elif mode == "status":
                frozen_install_module = importlib.import_module("resources.lib.frozen_install")
                transaction_module = importlib.import_module("resources.lib.transaction")
                library_module = importlib.import_module("resources.lib.build_library")
                verify_production_module_sources(addon_root, {
                    "resources.lib.frozen_install": frozen_install_module,
                    "resources.lib.transaction": transaction_module,
                    "resources.lib.build_library": library_module,
                })

                STAGE = "READ_STATUS"
                FAILING_CALLABLE = "read_adapter_status"
                frozen_root = frozen_install_module.default_frozen_install_root()
                restart_store = transaction_module.TransactionStore()
                status = read_adapter_status(
                    frozen_root / frozen_install_module._TRANSACTION_FILENAME,
                    frozen_root / frozen_install_module._LOCK_FILENAME,
                    restart_store.transaction_path,
                    restart_store.lock_path,
                    frozen_install_module.FrozenInstallTransaction.from_dict,
                    transaction_module.RestartTransaction.from_dict,
                )
                payload = {"ok": True, "status": status}
                identity = read_native_recovery_identity(frozen_root, restart_store.transaction_path)
                if identity is not None:
                    payload["recovery_identity"] = identity
            else:
                artifacts_module = importlib.import_module("resources.lib.artifacts")
                frozen_install_module = importlib.import_module("resources.lib.frozen_install")
                restart_module = importlib.import_module("resources.lib.restart_coordinator")
                update_guard_module = importlib.import_module("resources.lib.update_guard")
                verify_production_module_sources(addon_root, {
                    "resources.lib.artifacts": artifacts_module,
                    "resources.lib.frozen_install": frozen_install_module,
                    "resources.lib.restart_coordinator": restart_module,
                    "resources.lib.update_guard": update_guard_module,
                })

            if mode in ("status", "platform_check"):
                pass
            elif mode == "recover":
                frozen_module = importlib.import_module("resources.lib.frozen")
                verify_production_module_sources(addon_root, {
                    "resources.lib.frozen": frozen_module,
                })

                STAGE = "LOAD_FROZEN_MANIFEST"
                FAILING_CALLABLE = "pathlib.Path"
                RETAINED_INPUTS_RECORD = inspect_retained_inputs(MANIFEST_PATH, ARTIFACT_ROOT)
                require_retained_inputs(RETAINED_INPUTS_RECORD, require_artifacts=False)
                manifest_text = Path(MANIFEST_PATH).read_text(encoding="utf-8")
                FAILING_CALLABLE = "FrozenBuildManifest.from_json"
                recovery_document = json.loads(manifest_text)
                library_recovery = (isinstance(recovery_document, dict)
                    and recovery_document.get("schema") == "bm-library-recovery/1")
                if library_recovery:
                    # Require the explicit recovery document to survive the
                    # existing descriptor-pinned reader before using its pins.
                    recovery_document = json.loads(_platform_read(
                        MANIFEST_PATH, 4 * 1024 * 1024).decode("utf-8"))
                manifest = None if library_recovery else frozen_module.FrozenBuildManifest.from_json(manifest_text)

                STAGE = "CHECK_RECOVERY_PRECONDITIONS"
                FAILING_CALLABLE = "pathlib.Path"
                frozen_root = frozen_install_module.default_frozen_install_root()
                artifact_root = Path(ARTIFACT_ROOT)
                if not frozen_root.is_dir() or not (artifact_root / "artifacts").is_dir():
                    raise AdapterBootstrapError(
                        STAGE, FAILING_CALLABLE, "path_missing_or_unreadable"
                    )
                store = (frozen_install_module.FrozenInstallStore(root=frozen_root, create=False)
                         if library_recovery else frozen_install_module.FrozenInstallStore(root=frozen_root))
                policy_backend = update_guard_module.KodiJsonRpcUpdatePolicyBackend(_rpc)
                installer = frozen_install_module.KodiRuntimeFrozenArtifactBackend()
                STAGE = "CHECK_RECOVERY_PRECONDITIONS"
                FAILING_CALLABLE = "FrozenInstallStore.inspect"
                if library_recovery:
                    library_module = importlib.import_module("resources.lib.build_library")
                    verify_production_module_sources(addon_root, {"resources.lib.build_library": library_module})
                    payload = recover_library_frozen_install(recovery_document, store=store,
                        policy_backend=policy_backend, installer=installer,
                        restart_transaction_path=Path(restart_module.TransactionStore().transaction_path))
                else:
                    coordinator = frozen_install_module.FrozenInstallCoordinator(
                        store=store, artifact_store=artifacts_module.ArtifactStore(artifact_root),
                        policy_backend=policy_backend, installer=installer)
                    payload = recover_frozen_install(
                        coordinator, store, policy_backend, installer,
                        Path(restart_module.TransactionStore().transaction_path),
                        manifest=manifest, manifest_path=MANIFEST_PATH,
                        configuration_manifest_path=CONFIGURATION_PATH,
                        device_profile_id=DEVICE_PROFILE_ID, expected_overlay_id=EXPECTED_OVERLAY_ID,
                        needs_attention_phase=frozen_install_module.FrozenInstallPhase.NEEDS_ATTENTION,
                        update_policy_type=update_guard_module.AddonUpdatePolicy)
            elif mode == "retry":
                build_manager_module = importlib.import_module("resources.lib.build_manager")
                frozen_module = importlib.import_module("resources.lib.frozen")
                verify_production_module_sources(addon_root, {
                    "resources.lib.build_manager": build_manager_module,
                    "resources.lib.frozen": frozen_module,
                })

                STAGE = "LOAD_FROZEN_MANIFEST"
                FAILING_CALLABLE = "pathlib.Path"
                RETAINED_INPUTS_RECORD = inspect_retained_inputs(MANIFEST_PATH, ARTIFACT_ROOT)
                require_retained_inputs(RETAINED_INPUTS_RECORD)
                manifest_text = Path(MANIFEST_PATH).read_text(encoding="utf-8")
                FAILING_CALLABLE = "FrozenBuildManifest.from_json"
                manifest = frozen_module.FrozenBuildManifest.from_json(manifest_text)
                FAILING_CALLABLE = "pathlib.Path"
                if not Path(CONFIGURATION_PATH).is_file():
                    raise AdapterBootstrapError(
                        "CHECK_RETRY_PRECONDITIONS", "pathlib.Path", "path_missing_or_unreadable"
                    )

                STAGE = "CHECK_RETRY_PRECONDITIONS"
                if not (Path(ARTIFACT_ROOT) / "artifacts").is_dir():
                    raise AdapterBootstrapError(
                        STAGE, "pathlib.Path", "path_missing_or_unreadable"
                    )
                FAILING_CALLABLE = "default_frozen_install_root"
                durable_root = frozen_install_module.default_frozen_install_root()
                if not durable_root.is_dir():
                    raise AdapterBootstrapError(
                        STAGE, "pathlib.Path", "path_missing_or_unreadable"
                    )
                FAILING_CALLABLE = "ArtifactStore.__init__"
                source_store = artifacts_module.ArtifactStore(Path(ARTIFACT_ROOT))
                FAILING_CALLABLE = "FrozenInstallStore"
                frozen_store = frozen_install_module.FrozenInstallStore(root=durable_root)
                FAILING_CALLABLE = "ArtifactStore.__init__"
                durable_store = artifacts_module.ArtifactStore(
                    durable_root / "frozen-artifacts"
                )

                policy_backend = update_guard_module.KodiJsonRpcUpdatePolicyBackend(_rpc)
                installer = frozen_install_module.KodiRuntimeFrozenArtifactBackend()
                FAILING_CALLABLE = "TransactionStore"
                restart_store = restart_module.TransactionStore()
                FAILING_CALLABLE = "BuildManager"
                manager = build_manager_module.BuildManager()

                def run_held_retry_configuration(request, *, transaction_access=None):
                    return restart_module.RestartCoordinator(
                        manager, store=restart_store
                    ).reconcile(request, transaction_access=transaction_access)

                STAGE = "BUILD_COORDINATOR"
                FAILING_CALLABLE = "FrozenInstallCoordinator"
                coordinator = frozen_install_module.FrozenInstallCoordinator(
                    store=frozen_store,
                    artifact_store=durable_store,
                    policy_backend=policy_backend,
                    installer=installer,
                    configuration_runner=run_held_retry_configuration,
                )

                STAGE = "CHECK_RETRY_PRECONDITIONS"
                FAILING_CALLABLE = "FrozenInstallStore.inspect"
                payload = retry_held_frozen_install(
                    coordinator,
                    frozen_store,
                    source_store,
                    restart_store,
                    manifest=manifest,
                    manifest_path=MANIFEST_PATH,
                    configuration_manifest_path=CONFIGURATION_PATH,
                    device_profile_id=DEVICE_PROFILE_ID,
                    expected_overlay_id=EXPECTED_OVERLAY_ID,
                    transaction_type=frozen_install_module.FrozenInstallTransaction,
                    needs_attention_phase=frozen_install_module.FrozenInstallPhase.NEEDS_ATTENTION,
                    quiescence_awaiting_restart_stage=(
                        frozen_install_module.FrozenLifecycleStage.QUIESCENCE_AWAITING_RESTART
                    ),
                    automatic_update_policy=update_guard_module.AddonUpdatePolicy.AUTOMATIC,
                )
            else:
                build_manager_module = importlib.import_module("resources.lib.build_manager")
                frozen_module = importlib.import_module("resources.lib.frozen")
                private_overlay_module = importlib.import_module("resources.lib.private_overlay")
                verify_production_module_sources(addon_root, {
                    "resources.lib.build_manager": build_manager_module,
                    "resources.lib.frozen": frozen_module,
                    "resources.lib.private_overlay": private_overlay_module,
                })

                STAGE = "LOAD_FROZEN_MANIFEST"
                FAILING_CALLABLE = "pathlib.Path"
                RETAINED_INPUTS_RECORD = inspect_retained_inputs(MANIFEST_PATH, ARTIFACT_ROOT)
                require_retained_inputs(RETAINED_INPUTS_RECORD)
                manifest_text = Path(MANIFEST_PATH).read_text(encoding="utf-8")
                FAILING_CALLABLE = "FrozenBuildManifest.from_json"
                manifest = frozen_module.FrozenBuildManifest.from_json(manifest_text)

                STAGE = "STAGE_RETAINED_ARTIFACTS"
                FAILING_CALLABLE = "ArtifactStore.__init__"
                source_store = artifacts_module.ArtifactStore(Path(ARTIFACT_ROOT))
                FAILING_CALLABLE = "default_frozen_install_root"
                durable_root = frozen_install_module.default_frozen_install_root()
                FAILING_CALLABLE = "ArtifactStore.__init__"
                durable_store = artifacts_module.ArtifactStore(
                    durable_root / "frozen-artifacts"
                )
                FAILING_CALLABLE = "ArtifactStore.read_bytes"
                stage_manifest_artifacts(manifest, source_store, durable_store)

                STAGE = "LOAD_CONFIGURATION"
                FAILING_CALLABLE = "pathlib.Path"
                if not Path(CONFIGURATION_PATH).is_file():
                    raise AdapterBootstrapError(
                        STAGE, FAILING_CALLABLE, "path_missing_or_unreadable"
                    )

                STAGE = "LOAD_PRIVATE_OVERLAY"
                FAILING_CALLABLE = "PrivateOverlayStore.import_file"
                imported_overlay = private_overlay_module.PrivateOverlayStore().import_file(OVERLAY_SOURCE)
                if imported_overlay.overlay_id != EXPECTED_OVERLAY_ID:
                    raise AdapterBootstrapError(STAGE, FAILING_CALLABLE, "invalid_input")

                manager = build_manager_module.BuildManager()

                def resolve_missing_artifact(prompt):
                    return choose_missing_artifact_resolution(
                        prompt, frozen_install_module.ResolutionChoice
                    )

                def run_configuration(request, *, transaction_access=None):
                    return restart_module.RestartCoordinator(manager).reconcile(
                        request, transaction_access=transaction_access
                    )

                STAGE = "BUILD_COORDINATOR"
                FAILING_CALLABLE = "FrozenInstallCoordinator"
                coordinator = frozen_install_module.FrozenInstallCoordinator(
                    store=frozen_install_module.FrozenInstallStore(),
                    artifact_store=durable_store,
                    policy_backend=update_guard_module.KodiJsonRpcUpdatePolicyBackend(_rpc),
                    installer=frozen_install_module.KodiRuntimeFrozenArtifactBackend(),
                    configuration_runner=run_configuration,
                    resolution_decider=resolve_missing_artifact,
                )
                STAGE = "INVOKE_INSTALL"
                FAILING_CALLABLE = "FrozenInstallCoordinator.install"
                result = coordinator.install(
                    manifest,
                    manifest_path=MANIFEST_PATH,
                    device_profile_id=DEVICE_PROFILE_ID,
                    configuration_manifest_path=CONFIGURATION_PATH,
                    interactive=True,
                )
                transaction = frozen_install_module.FrozenInstallStore().inspect()
                installed = {}
                for node in manifest.addons:
                    if node.system:
                        continue
                    detail = coordinator.installer.get_addon_details(node.addon_id)
                    installed[node.addon_id] = None if detail is None else {
                        "version": detail.version,
                        "enabled": detail.enabled,
                        "broken": detail.broken,
                    }
                policy_result = _rpc("Settings.GetSettingValue", {"setting": "general.addonupdates"})

                STAGE = "SERIALIZE_RESULT"
                FAILING_CALLABLE = "result_serializer"
                payload = {
                    "ok": True,
                    "outcome": result.outcome,
                    "code": result.code,
                    "frozen_manifest_fingerprint": manifest.fingerprint(),
                    "overlay_imported": True,
                    "transaction": _safe_transaction(transaction),
                    "installation_order": list(coordinator.installer.install_order),
                    "installed": installed,
                    "updater_policy": policy_result.get("value") if isinstance(policy_result, dict) else None,
                }
        except Exception as exc:
            payload = safe_failure_payload(STAGE, FAILING_CALLABLE, exc)
        payload = identify_adapter_result(payload, mode)
        if FROZEN_INSTALL_SOURCE_RECORD is not None:
            payload["frozen_install_source"] = dict(FROZEN_INSTALL_SOURCE_RECORD)
        if RETAINED_INPUTS_RECORD is not None:
            payload["retained_inputs"] = dict(RETAINED_INPUTS_RECORD)
        if mode == "platform_check":
            write_platform_result(RESULT_PATH, payload)
        else:
            _write_result(payload)


    main()
finally:
    sys.dont_write_bytecode = _PREVIOUS_BYTECODE_FLAG
    if _PLATFORM_REQUESTED:
        sys.path[:] = _PREVIOUS_SYS_PATH
        sys.meta_path[:] = _PREVIOUS_META_PATH
        for _name in list(sys.modules):
            if _platform_module(_name) and _name not in _PREVIOUS_PLATFORM_MODULES:
                del sys.modules[_name]
        sys.modules.update(_PREVIOUS_PLATFORM_MODULES)
